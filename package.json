{
  "name": "radsportmanager",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:r01": "node --experimental-strip-types --test tests/r01-flat.test.mjs",
    "test:r02": "node --experimental-strip-types --test tests/r02-climb.test.mjs",
    "test:route": "node --experimental-strip-types --test tests/dynamic-route.test.mjs",
    "test:corners": "node --experimental-strip-types --test tests/corner-route.test.mjs",
    "test:unified": "node --experimental-strip-types --test tests/unified-motion.test.mjs",
    "bench:isolated": "node --experimental-strip-types benchmarks/isolated-riders.mjs",
    "test:r03": "node --experimental-strip-types --test tests/drafting-pair.test.mjs",
    "bench:r03": "node --experimental-strip-types benchmarks/r03-pair.mjs",
    "build:benchmark": "tsc --target ES2022 --module ES2022 --moduleResolution Bundler --rewriteRelativeImportExtensions true --skipLibCheck --rootDir src/engine --outDir docs/benchmark/generated src/engine/physics/drafting-pair.ts src/engine/physics/drafting-group.ts src/engine/race/race-simulator.ts",
    "test:gruppe": "node --experimental-strip-types --test tests/drafting-group.test.mjs",
    "test:agent": "node --experimental-strip-types --test tests/gap-controller.test.mjs",
    "test:r05": "node --experimental-strip-types --test tests/r05-safety-cp.test.mjs",
    "test:race": "node --experimental-strip-types --test tests/r09-race.test.mjs"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
